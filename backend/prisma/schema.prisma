generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PROVIDER
  FRONT_DESK
  PATIENT
}

enum AppointmentStatus {
  DRAFT
  PENDING_PROVIDER_APPROVAL
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentRequirementType {
  NONE
  DEPOSIT
  FULL
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum BookingSource {
  PUBLIC
  PATIENT_PORTAL
  FRONT_DESK
  PROVIDER
  WAITLIST
}

enum SlotHoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
}

enum VisitRecordStatus {
  DRAFT
  FINAL
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum FormScope {
  CLINIC
  DISCIPLINE
  SERVICE
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

enum AIScribeStatus {
  RECORDING
  TRANSCRIBING
  DRAFT_GENERATED
  EDITED
  APPROVED
  FAILED
}

enum ConsultationStatus {
  NOT_STARTED
  READY
  LIVE
  RECORDING
  ENDED
  PROCESSING
  TRANSCRIPT_READY
  FAILED
}

enum RecordingStatus {
  NOT_STARTED
  RECORDING
  STOPPED
  UPLOADING
  STORED
  FAILED
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum CartItemType {
  SERVICE
  PRODUCT
  PACKAGE
  MEMBERSHIP
}

enum PackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CommissionType {
  PERCENTAGE
  FLAT_RATE
}

enum CommissionItemType {
  ALL
  SERVICE
  PRODUCT
  PACKAGE
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

model Clinic {
  id               String   @id @default(cuid())
  name             String
  email            String
  subscriptionPlan String   @default("free")
  isActive         Boolean  @default(true)
  aiEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                     User[]
  disciplines               Discipline[]
  providers                 Provider[]
  locations                 Location[]
  services                  Service[]
  appointments              Appointment[]
  visitRecords              VisitRecord[]
  prescriptions             Prescription[]
  auditLogs                 AuditLog[]
  waitlistEntries           WaitlistEntry[]
  slotHolds                 SlotHold[]
  payments                  Payment[]
  treatmentPlans            TreatmentPlan[]
  patientFiles              PatientFile[]
  formTemplates             FormTemplate[]
  formResponses             FormResponse[]
  invoices                  Invoice[]
  aiScribeSessions          AIScribeSession[]
  appointmentSeries         AppointmentSeries[]
  products                  Product[]
  inventoryItems            InventoryItem[]
  packages                  Package[]
  memberships               Membership[]
  patientMemberships        PatientClinicMembership[]
  googleCalendarConnections GoogleCalendarConnection[]
  googleCalendarEvents      GoogleCalendarEvent[]
  consultationSessions      ConsultationSession[]
  carts                     Cart[]
  commissionRules           CommissionRule[]
  commissionRecords         CommissionRecord[]
}

model User {
  id        String   @id @default(cuid())
  clinicId  String?
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic                        Clinic?                    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  provider                      Provider?
  passwordSetupTokens           PasswordSetupToken[]
  refreshTokens                 RefreshToken[]
  appointments                  Appointment[]
  appointmentSeries             AppointmentSeries[]
  visitRecords                  VisitRecord[]
  prescriptions                 Prescription[]
  auditLogs                     AuditLog[]
  waitlistEntries               WaitlistEntry[]
  payments                      Payment[]
  visitNoteVersions             VisitNoteVersion[]
  treatmentPlans                TreatmentPlan[]            @relation("PatientPlans")
  patientFiles                  PatientFile[]              @relation("PatientFiles")
  uploadedFiles                 PatientFile[]              @relation("UploadedFiles")
  formResponses                 FormResponse[]
  invoices                      Invoice[]
  patientClinicMemberships      PatientClinicMembership[]  @relation("PatientClinicMemberships")
  googleCalendarConnections     GoogleCalendarConnection[]
  consultationSessionsAsPatient ConsultationSession[]
  carts                         Cart[]                     @relation("PatientCarts")
  patientPackages               PatientPackage[]           @relation("PatientPackages")
  patientSubscriptions          PatientSubscription[]      @relation("PatientSubscriptions")
}

model Discipline {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  providerDisciplines ProviderDiscipline[]
  services            Service[]
  treatmentPlans      TreatmentPlan[]
  formTemplates       FormTemplate[]

  @@unique([clinicId, name])
}

model ProviderDiscipline {
  id           String @id @default(cuid())
  providerId   String
  disciplineId String

  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([providerId, disciplineId])
  @@index([providerId])
  @@index([disciplineId])
}

model Provider {
  id            String   @id @default(cuid())
  clinicId      String
  userId        String?  @unique
  firstName     String
  lastName      String
  email         String?
  phone         String?
  bufferMinutes Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic                 Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  disciplines            ProviderDiscipline[]
  user                   User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerServices       ProviderService[]
  appointments           Appointment[]
  visitRecords           VisitRecord[]
  prescriptions          Prescription[]
  providerAvailability   ProviderAvailability[]
  providerUnavailability ProviderUnavailability[]
  waitlistEntries        WaitlistEntry[]
  treatmentPlans         TreatmentPlan[]
  invoices               Invoice[]
  aiScribeSessions       AIScribeSession[]
  appointmentSeries      AppointmentSeries[]
  slotHolds              SlotHold[]
  locationAssignments    ProviderLocationAssignment[]
  googleCalendarEvents   GoogleCalendarEvent[]
  consultationSessions   ConsultationSession[]
  commissionRules        CommissionRule[]
  commissionRecords      CommissionRecord[]

  @@index([clinicId])
}

model ProviderLocationAssignment {
  id         String   @id @default(cuid())
  providerId String
  locationId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([providerId, locationId])
  @@index([locationId])
  @@index([providerId, isPrimary])
}

model ProviderAvailability {
  id         String   @id @default(cuid())
  providerId String
  locationId String?
  weekday    Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model ProviderUnavailability {
  id         String   @id @default(cuid())
  providerId String
  date       DateTime
  startTime  String?
  endTime    String?
  reason     String?
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([date])
}

model Location {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  address   String?
  timezone  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic              Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  slotHolds           SlotHold[]
  providerAssignments ProviderLocationAssignment[]
  patientMemberships  PatientClinicMembership[]    @relation("PatientMembershipPrimaryLocation")

  @@unique([clinicId, name])
}

model PatientClinicMembership {
  id                String   @id @default(cuid())
  clinicId          String
  patientId         String
  primaryLocationId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         User      @relation("PatientClinicMemberships", fields: [patientId], references: [id], onDelete: Restrict)
  primaryLocation Location? @relation("PatientMembershipPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)

  @@unique([clinicId, patientId])
  @@index([patientId])
  @@index([clinicId, isActive])
}

model SlotHold {
  id                       String         @id @default(cuid())
  clinicId                 String
  providerId               String
  serviceId                String
  locationId               String?
  timezone                 String         @default("UTC")
  startTime                DateTime
  endTime                  DateTime
  patientId                String?
  expiresAt                DateTime
  status                   SlotHoldStatus @default(ACTIVE)
  bookingSource            BookingSource  @default(PUBLIC)
  releasedAt               DateTime?
  expiredAt                DateTime?
  convertedToAppointmentId String?
  createdAt                DateTime       @default(now())

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([expiresAt])
  @@index([providerId, startTime])
}

model Service {
  id                      String   @id @default(cuid())
  clinicId                String
  disciplineId            String
  name                    String
  duration                Int
  defaultPrice            Decimal  @db.Decimal(10, 2)
  taxApplicable           Boolean  @default(false)
  minimumNoticeMinutes    Int?     @default(0)
  maxFutureBookingDays    Int?     @default(365)
  cancellationWindowHours Int?     @default(0)
  cancellationFeeType     String?  @default("NONE")
  cancellationFeeValue    Decimal? @db.Decimal(10, 2)
  prepaymentType          String   @default("NONE") // NONE, DEPOSIT, FULL
  depositAmount           Decimal? @db.Decimal(10, 2)
  requirePrepayment       Boolean  @default(false)
  requireProviderApproval Boolean  @default(false)
  isActive                Boolean  @default(true)
  isArchived              Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  discipline        Discipline          @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  providerServices  ProviderService[]
  appointments      Appointment[]
  appointmentSeries AppointmentSeries[]
  waitlistEntries   WaitlistEntry[]
  slotHolds         SlotHold[]
  formTemplates     FormTemplate[]
  invoiceItems      InvoiceItem[]
  cartItems         CartItem[]
  commissionRules   CommissionRule[]
  recommendedProducts Product[] @relation("ServiceRecommendations")

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([disciplineId])
}

model ProviderService {
  id            String   @id @default(cuid())
  providerId    String
  serviceId     String
  priceOverride Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
}

model Invoice {
  id            String        @id @default(cuid())
  clinicId      String
  locationId    String?
  appointmentId String?
  patientId     String
  providerId    String?
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient           User               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider          Provider?          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  items             InvoiceItem[]
  commissionRecords CommissionRecord[]

  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([appointmentId])
  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  serviceId    String?
  disciplineId String?
  providerId   String?
  description  String
  unitPrice    Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
  totalPrice   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  productId         String?
  packageId         String?
  membershipId      String?
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  package           Package?           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  membership        Membership?        @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  commissionRecords CommissionRecord[]

  @@index([invoiceId])
  @@index([serviceId])
  @@index([productId])
  @@index([packageId])
  @@index([membershipId])
}

model Appointment {
  id                     String                 @id @default(cuid())
  clinicId               String
  locationId             String?
  providerId             String
  serviceId              String
  disciplineId           String?
  patientId              String
  timezone               String                 @default("UTC")
  startTime              DateTime
  endTime                DateTime
  status                 AppointmentStatus      @default(CONFIRMED)
  priceAtBooking         Decimal                @db.Decimal(10, 2)
  paymentStatus          PaymentStatus          @default(NONE)
  paymentRequirementType PaymentRequirementType @default(NONE)
  approvalStatus         ApprovalStatus         @default(NOT_REQUIRED)
  bookingSource          BookingSource          @default(PUBLIC)
  depositAmount          Decimal?               @db.Decimal(10, 2)
  paymentDueAt           DateTime?
  slotHeldUntil          DateTime?
  bookingHoldExpiresAt   DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  notes                  String?                @db.Text
  createdById            String?
  updatedById            String?
  reminderSent           Boolean                @default(false)
  recurringSeriesId      String?
  rescheduledFromId      String?                @unique
  rescheduledToId        String?
  meetLink               String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  provider        Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  patient         User               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recurringSeries AppointmentSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)

  rescheduledFrom Appointment? @relation("RescheduleFrom", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment? @relation("RescheduleFrom")

  visitRecords         VisitRecord[]
  prescriptions        Prescription[]
  payments             Payment[]
  formResponses        FormResponse[]
  invoices             Invoice[]
  consultationSessions ConsultationSession[]
  cartItem             CartItem?
  packageSessionUsages PackageSessionUsage[]

  @@index([providerId])
  @@index([patientId])
  @@index([clinicId])
  @@index([locationId])
  @@index([startTime])
  @@index([status])
  @@index([providerId, startTime])
  @@index([clinicId, startTime])
  @@index([patientId, startTime])
  @@index([recurringSeriesId])
}

model Payment {
  id                 String        @id @default(cuid())
  clinicId           String
  providerId         String?
  invoiceId          String?
  appointmentId      String?
  patientId          String
  refundForPaymentId String?
  stripePaymentIntentId String?    @unique
  stripeClientSecret    String?
  amount             Decimal       @db.Decimal(10, 2)
  status             PaymentStatus
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User         @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([status])
  @@index([refundForPaymentId])
}

model Product {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  description String?
  sku         String?
  price       Decimal  @db.Decimal(10, 2)
  taxApplicable Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?
  cartItems       CartItem[]
  commissionRules CommissionRule[]
  invoiceItems    InvoiceItem[]
  recommendedForServices Service[] @relation("ServiceRecommendations")

  @@unique([clinicId, name])
  @@index([clinicId])
}

model InventoryItem {
  id               String    @id @default(cuid())
  clinicId         String
  productId        String    @unique
  quantityInStock  Int       @default(0)
  reorderThreshold Int?
  supplier         String?
  batchNumber      String?
  expiryDate       DateTime?
  storageLocation  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model Package {
  id            String   @id @default(cuid())
  clinicId      String
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  taxApplicable Boolean  @default(false)
  totalSessions Int?
  expiresInDays Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  commissionRules CommissionRule[]
  invoiceItems    InvoiceItem[]
  patientPackages PatientPackage[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Membership {
  id            String   @id @default(cuid())
  clinicId      String
  name          String
  description   String?
  monthlyPrice  Decimal  @db.Decimal(10, 2)
  billingPeriod String   @default("MONTHLY")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic               Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  cartItems            CartItem[]
  patientSubscriptions PatientSubscription[]
  invoiceItems         InvoiceItem[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model GoogleCalendarConnection {
  id           String    @id @default(cuid())
  userId       String
  clinicId     String
  email        String
  accessToken  String
  refreshToken String?
  tokenType    String?
  scope        String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  events GoogleCalendarEvent[]

  @@unique([userId, clinicId])
  @@index([clinicId])
}

model GoogleCalendarEvent {
  id            String   @id @default(cuid())
  connectionId  String
  clinicId      String
  providerId    String?
  googleEventId String
  summary       String?
  startTime     DateTime
  endTime       DateTime
  meetLink      String?
  status        String
  appointmentId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  clinic     Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider   Provider?                @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@unique([connectionId, googleEventId])
  @@index([clinicId, startTime])
  @@index([providerId, startTime])
}

model VisitRecord {
  id               String            @id @default(cuid())
  clinicId         String
  locationId       String?
  appointmentId    String            @unique
  providerId       String
  serviceId        String?
  disciplineId     String?
  patientId        String
  subjective       String?
  objective        String?
  assessment       String?
  plan             String?
  note             String?           @db.Text
  status           VisitRecordStatus @default(DRAFT)
  currentVersionId String?           @unique
  isFinalized      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  clinic         Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider       Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  patient        User               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  versions       VisitNoteVersion[]
  currentVersion VisitNoteVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  patientFiles   PatientFile[]
  aiSessions     AIScribeSession[]

  @@index([patientId])
}

model AIScribeSession {
  id            String @id @default(cuid())
  visitRecordId String
  providerId    String
  clinicId      String

  audioUrl       String?
  transcript     String?
  timeline       Json?
  aiDraft        Json?
  patientSummary Json?

  status                  AIScribeStatus @default(RECORDING)
  patientSummaryPublished Boolean        @default(false)

  aiModel               String?
  errorMessage          String?
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitRecord         VisitRecord          @relation(fields: [visitRecordId], references: [id], onDelete: Cascade)
  provider            Provider             @relation(fields: [providerId], references: [id], onDelete: Restrict)
  clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  consultationSession ConsultationSession?

  @@index([visitRecordId])
  @@index([providerId])
  @@index([clinicId])
}

model VisitNoteVersion {
  id            String   @id @default(cuid())
  visitRecordId String
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  createdAt     DateTime @default(now())
  createdById   String

  visitRecord      VisitRecord  @relation(fields: [visitRecordId], references: [id], onDelete: Cascade)
  createdBy        User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  currentForRecord VisitRecord? @relation("CurrentVersion")

  @@index([visitRecordId])
}

model Prescription {
  id            String   @id @default(cuid())
  clinicId      String
  appointmentId String
  providerId    String
  patientId     String
  notes         String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  patient     User        @relation(fields: [patientId], references: [id], onDelete: Restrict)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  clinicId      String
  entityType    String
  entityId      String
  action        String
  fieldChanged  String?
  oldValue      Json?
  newValue      Json?
  performedById String
  createdAt     DateTime @default(now())

  clinic      Clinic @relation(fields: [clinicId], references: [id])
  performedBy User   @relation(fields: [performedById], references: [id])

  @@index([clinicId])
  @@index([entityType])
  @@index([entityId])
}

model WaitlistEntry {
  id                  String         @id @default(cuid())
  clinicId            String
  providerId          String
  serviceId           String
  patientId           String
  preferredLocationId String?
  timezone            String         @default("UTC")
  preferredDate       DateTime
  preferredStartTime  String
  preferredEndTime    String
  status              WaitlistStatus @default(WAITING)
  offeredAt           DateTime?
  expiresAt           DateTime?
  offeredStartTime    DateTime?
  offeredEndTime      DateTime?
  offeredLocationId   String?
  createdAt           DateTime       @default(now())

  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  patient  User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([serviceId])
  @@index([status])
  @@index([patientId])
  @@index([clinicId])
}

model AppointmentSeries {
  id               String    @id @default(cuid())
  clinicId         String
  patientId        String
  providerId       String
  serviceId        String
  locationId       String?
  timezone         String
  frequency        String
  numberOfSessions Int?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      User          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([clinicId])
  @@index([patientId])
  @@index([providerId])
}

model TreatmentPlan {
  id                String              @id @default(cuid())
  clinicId          String
  patientId         String
  providerId        String
  disciplineId      String
  name              String
  totalSessions     Int
  sessionsCompleted Int                 @default(0)
  startDate         DateTime
  endDate           DateTime?
  goals             Json?
  notes             String?
  status            TreatmentPlanStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    User       @relation("PatientPlans", fields: [patientId], references: [id], onDelete: Restrict)
  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([providerId])
  @@index([clinicId])
}

model PatientFile {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  visitRecordId String?
  uploadedById  String
  originalName  String
  storagePath   String
  mimeType      String
  size          Int
  tags          Json?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     User         @relation("PatientFiles", fields: [patientId], references: [id], onDelete: Restrict)
  visitRecord VisitRecord? @relation(fields: [visitRecordId], references: [id], onDelete: SetNull)
  uploadedBy  User         @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([clinicId])
  @@index([visitRecordId])
}

model FormTemplate {
  id           String    @id @default(cuid())
  clinicId     String
  name         String
  description  String?
  scope        FormScope
  disciplineId String?
  serviceId    String?
  fields       Json
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinic     Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  discipline Discipline?    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  service    Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  responses  FormResponse[]

  @@index([clinicId])
}

model FormResponse {
  id            String   @id @default(cuid())
  clinicId      String
  templateId    String
  patientId     String
  appointmentId String?
  responses     Json
  createdAt     DateTime @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  patient     User         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([clinicId])
  @@index([templateId])
}

model ConsultationSession {
  id                String             @id @default(cuid())
  clinicId          String
  appointmentId     String
  providerId        String
  patientId         String
  status            ConsultationStatus @default(NOT_STARTED)
  recordingStatus   RecordingStatus    @default(NOT_STARTED)
  consentStatus     ConsentStatus      @default(PENDING)
  consentGrantedAt  DateTime?
  joinToken         String             @unique
  joinTokenExpiresAt DateTime
  recordingUrl      String?
  transcriptText    String?            @db.Text
  transcriptStatus  String             @default("NOT_STARTED")
  aiScribeSessionId String?            @unique
  startedAt         DateTime?
  endedAt           DateTime?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment     Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  patient         User             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  aiScribeSession AIScribeSession? @relation(fields: [aiScribeSessionId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([appointmentId])
  @@index([providerId])
  @@index([patientId])
}

// --- MODULE 4: COMMERCE & REVENUE ENGINE ADDITIONS ---

model Cart {
  id        String     @id @default(cuid())
  clinicId  String
  patientId String
  status    CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient User       @relation("PatientCarts", fields: [patientId], references: [id], onDelete: Cascade)
  items   CartItem[]

  @@index([clinicId, patientId, status])
  @@index([clinicId])
  @@index([patientId])
}

model CartItem {
  id        String       @id @default(cuid())
  cartId    String
  itemType  CartItemType
  quantity  Int          @default(1)
  unitPrice Decimal      @db.Decimal(10, 2)

  serviceId    String?
  productId    String?
  packageId    String?
  membershipId String?

  appointmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  package     Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  membership  Membership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([serviceId])
  @@index([productId])
  @@index([packageId])
  @@index([membershipId])
}

model PatientPackage {
  id            String        @id @default(cuid())
  clinicId      String
  patientId     String
  packageId     String
  invoiceId     String?
  status        PackageStatus @default(ACTIVE)
  totalSessions Int
  usedSessions  Int           @default(0)
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient  User                  @relation("PatientPackages", fields: [patientId], references: [id], onDelete: Cascade)
  package  Package               @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sessions PackageSessionUsage[]

  @@index([patientId, status])
  @@index([clinicId])
}

model PackageSessionUsage {
  id               String   @id @default(cuid())
  patientPackageId String
  appointmentId    String   @unique
  usedAt           DateTime @default(now())

  patientPackage PatientPackage @relation(fields: [patientPackageId], references: [id], onDelete: Cascade)
  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model PatientSubscription {
  id                   String             @id @default(cuid())
  clinicId             String
  patientId            String
  membershipId         String
  stripeSubscriptionId String?
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  patient    User       @relation("PatientSubscriptions", fields: [patientId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([clinicId])
}

model CommissionRule {
  id              String             @id @default(cuid())
  clinicId        String
  providerId      String?
  itemType        CommissionItemType @default(ALL)
  serviceId       String?
  productId       String?
  packageId       String?
  commissionType  CommissionType
  commissionValue Decimal            @db.Decimal(10, 2)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  package  Package?  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  records CommissionRecord[]

  @@index([clinicId])
  @@index([providerId])
  @@index([itemType])
}

model CommissionRecord {
  id            String           @id @default(cuid())
  clinicId      String
  providerId    String
  invoiceId     String
  invoiceItemId String
  ruleId        String?
  basisAmount   Decimal          @db.Decimal(10, 2)
  amount        Decimal          @db.Decimal(10, 2)
  status        CommissionStatus @default(PENDING)
  earnedAt      DateTime
  paidOutAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider    Provider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem     @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  rule        CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([providerId])
  @@index([invoiceId])
  @@index([status])
  @@index([earnedAt])
}
