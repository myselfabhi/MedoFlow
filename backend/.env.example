PORT=3001
PRISMA_HIDE_UPDATE_MESSAGE=true
DATABASE_URL="postgresql://username:password@localhost:5432/medoflow?schema=public"
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key-change-in-production
STRIPE_SECRET=your-stripe-secret-key
FILE_SIZE_LIMIT_MB=10

# Provider invite email (optional - logs link to console if not set)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medoflow.com

# AI Scribe (OpenAI Whisper + GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis (for BullMQ AI Scribe worker)
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# S3-compatible storage for audio (optional - falls back to local uploads/)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=medoflow-ai-scribe
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_PUBLIC_URL=
