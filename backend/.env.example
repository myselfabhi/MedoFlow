PORT=3001
NODE_ENV=development
PRISMA_HIDE_UPDATE_MESSAGE=true

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/medoflow?schema=public"

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. In development, localhost is allowed when unset.
CORS_ORIGIN=http://localhost:3000

# ─── Auth ───────────────────────────────────────────────────────────────────
# Min 32 chars, random — generate with: openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-characters-long
FRONTEND_URL=http://localhost:3000

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Redis (BullMQ) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medoflow.com

# ─── AI Scribe ───────────────────────────────────────────────────────────────
# OpenAI — primary transcription + SOAP generation
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama — local/offline alternative (optional)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Whisper model size (tiny|base|small|medium|large) — applies to local Whisper
WHISPER_MODEL_SIZE=small.en

# ─── File Storage (S3 / MinIO) ───────────────────────────────────────────────
# When both keys are set, S3 is used; otherwise, local uploads/ directory is used.
FILE_SIZE_LIMIT_MB=10
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=medoflow-ai-scribe
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_PUBLIC_URL=

# ─── Google Calendar / Meet ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte hex key — generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ─── Daily.co (video consultations) ─────────────────────────────────────────
DAILY_API_KEY=

# ─── App URL aliases ─────────────────────────────────────────────────────────
# Fallback for links in emails when FRONTEND_URL is not set
APP_URL=http://localhost:3000
